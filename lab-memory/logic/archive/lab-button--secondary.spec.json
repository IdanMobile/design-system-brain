      "description": "Visual style."
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "default": "\"md\""
    },
    {
      "name": "iconLeft",
      "type": "boolean",
      "default": "false",
      "description": "Renders the leading plus icon."
    },
    {
      "name": "iconRight",
      "type": "boolean",
      "default": "false",
      "description": "Renders the trailing arrow icon."
    },
    {
      "name": "children",
      "type": "React.ReactNode",
      "default": "\"Secondary\"",
      "description": "Button label."
    }
  ],
  "events": [
    {
      "name": "onSecondaryClicked",
      "trigger": "(accepted from drift sidecar — please describe in showcase)"
    }
  ],
  "behaviours": [
    {
      "id": "hover",
      "label": "Pointer enters the button → Brightness boost + shadow lift",
