{
  "name": "storybook-to-figma-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:browsers": "pnpm --filter @lab/extractor-playwright exec playwright install chromium",
    "storybook": "pnpm --filter @lab/storybook-lab storybook",
    "storybook:build": "pnpm --filter @lab/storybook-lab build",
    "storybook:serve": "node scripts/serve-storybook.mjs",
    "build": "pnpm -r build",
    "extract": "node scripts/extract.mjs",
    "extract:all": "pnpm --filter @lab/extractor-playwright extract:all",
    "artifacts:cleanup": "node cleanup-artifacts.mjs",
    "refresh:figma": "pnpm --filter @lab/figma-importer-plugin build && pnpm extract:all",
    "refresh:figma:clean": "pnpm refresh:figma && pnpm artifacts:cleanup",
    "test:pixel": "pnpm --filter @lab/pixel-test test",
    "test:pixel:golden": "pnpm --filter @lab/pixel-test test:golden",
    "test:pixel:all": "pnpm --filter @lab/pixel-test test:all",
    "test:figma": "pnpm --filter @lab/pixel-test test:figma",
    "test:figma:golden": "pnpm --filter @lab/pixel-test test:figma:golden",
    "test:figma:all": "pnpm --filter @lab/pixel-test test:figma:all",
    "figma:relay": "node scripts/figma-live-relay.mjs",
    "figma:plugin-reload": "node scripts/figma-plugin-reload.mjs",
    "figma:plugin:build-reload": "pnpm --filter @lab/figma-importer-plugin build && node scripts/figma-plugin-reload.mjs",
    "test:figma:live": "pnpm --filter @lab/pixel-test test:figma:live",
    "test:figma:live:golden": "pnpm --filter @lab/pixel-test test:figma:live:golden",
    "figma:live-iterate": "node scripts/figma-live-iterate.mjs",
    "figma:live-iterate:status": "node scripts/figma-live-iterate.mjs --status",
    "figma:iterate": "node scripts/figma-iterate.mjs",
    "figma:iterate:strict": "node scripts/figma-iterate.mjs --strict",
    "playground:build": "pnpm --filter @lab/developer-playground build",
    "playground:dev": "pnpm --filter @lab/developer-playground dev",
    "playground:serve": "node scripts/serve-playground.mjs",
    "test:delivery": "pnpm --filter @lab/pixel-test test:delivery",
    "test:delivery:golden": "pnpm --filter @lab/pixel-test test:delivery:golden",
    "test:delivery:all": "pnpm --filter @lab/pixel-test test:delivery:all",
    "test:logic:audit": "pnpm --filter @lab/pixel-test test:logic:audit",
    "test:logic:audit:all": "pnpm --filter @lab/pixel-test test:logic:audit:all",
    "test:logic:audit:record": "pnpm --filter @lab/pixel-test test:logic:audit:record",
    "test:console:build": "pnpm --filter @lab/test-console build",
    "test:console": "node scripts/test-console-start.mjs",
    "test:console:restart": "node scripts/test-console-restart.mjs",
    "test:console:foreground": "pnpm test:console:build && node scripts/test-console-server.mjs",
    "test:console:dev": "node scripts/test-console-dev.mjs",
    "test:console:agent": "node scripts/test-console-agent.mjs",
    "test:console:open": "node scripts/test-console-agent.mjs open",
    "test:console:cursor": "node scripts/test-console-cursor.mjs",
    "test:portfolio:refresh": "node scripts/test-portfolio-merge.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "test:regression:tier-a": "node scripts/test-regression.mjs --tier a",
    "test:regression:tier-b": "node scripts/test-regression.mjs --tier b",
    "test:regression:tier-c": "node scripts/test-regression.mjs --tier c",
    "orchestrator:context": "node scripts/orchestrator-context.mjs",
    "test:supervisor": "node --test scripts/test-console-worker-supervisor.test.mjs scripts/regression-tiers.test.mjs scripts/iterate-report-exit.test.mjs scripts/sandbox-promote.test.mjs scripts/architecture-console.test.mjs scripts/developer-proposal.test.mjs",
    "test:fix-all-batch": "node --test scripts/fix-all-batch-report.test.mjs",
    "test:run-settings": "node --test scripts/test-console-run-settings.test.mjs",
    "test:agent-models": "node --test scripts/test-console-agent-models.test.mjs",
    "test:terminal": "node --test scripts/test-console-terminal.test.mjs",
    "infra:health": "node scripts/infra-health.mjs",
    "infra:ensure": "node scripts/infra-health.mjs --start-missing",
    "test:parallel": "node scripts/test-console-parallel.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@9.12.3"
}
