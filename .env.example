# Optional — enables the ✨ "Improve with AI" button on the showcase Element panel.
#
# Without these variables the lab still works end-to-end: the local heuristic
# extractor populates `aiExtracted` on every audit run. With them, designers
# can opt-in to a higher-fidelity LLM polish that re-writes the behaviour
# sentence and developer-API entries.
#
# Provider — "openai" (default) or "anthropic"
LAB_LLM_PROVIDER=openai
# API key for the configured provider
LAB_LLM_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-3-5-haiku-latest)
# LAB_LLM_MODEL=gpt-4o-mini
