# Optional — enables the ✨ "Improve with AI" button on the showcase Element panel.
#
# Preferred: configure in Tests Console → LLM (showcase) — saves to
# `.test-console/llm-settings.json` (gitignored).
#
# Fallback: set env vars below (e.g. CI or when console is not running).
#
# Provider — "openai" (default), "anthropic", or "gemini"
LAB_LLM_PROVIDER=openai
# API key for the configured provider
LAB_LLM_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-3-5-haiku-latest / gemini-2.0-flash)
# LAB_LLM_MODEL=gpt-4o-mini
